# Copy to .env.local for local work. Never commit real values.
# Everything is validated lazily at request time (src/server/env.ts), so
# builds and CI run without any of these.

# --- OpenAI ---
# The key has a hard $20 limit enforced by OpenAI billing; the app keeps no
# dollar accounting of its own. Needed only for live voice sessions (M6+).
# Tests and CI never use it.
OPENAI_API_KEY=
# gpt-realtime-2.1-mini (default) or gpt-realtime-2.1 (production, at the end)
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=marin
# minimal | low | medium | high
REALTIME_REASONING_EFFORT=low

# --- Document context and limits ---
# Max document tokens sent to the model (1000-60000). 8000 while building,
# 20000 in final production.
CONTEXT_TOKEN_BUDGET=8000
# Hard length of one voice session
MAX_SESSION_MINUTES=5
# How long an extracted document is kept
DOC_TTL_MINUTES=120

# --- Cost guards ---
# Kill switch for voice sessions
VOICE_ENABLED=true
# Session starts per UTC day, all visitors together (per-IP limiting is in code)
DAILY_SESSION_CAP=40

# --- Upload ---
# direct = multipart POST to the route (local, CI). blob = browser to Vercel Blob
# (default on Vercel; direct is refused there because of the 4.5 MB body cap).
UPLOAD_MODE=direct
# Set automatically when you connect a Blob store on Vercel
BLOB_READ_WRITE_TOKEN=

# --- YouTube fallback (optional) ---
SUPADATA_API_KEY=

# --- Shared state ---
# Leave empty locally to use in-memory state. On Vercel these are required
# (add Upstash Redis from the Marketplace). The KV_REST_API_* names also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Client-side (not secret) ---
# webrtc (default) or mock. Playwright sets mock.
NEXT_PUBLIC_REALTIME_TRANSPORT=webrtc
